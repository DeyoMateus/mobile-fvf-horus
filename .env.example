# Copie para .env (ou .env.local) na raiz de mobile/. O Expo CLI carrega
# automaticamente qualquer variável prefixada com EXPO_PUBLIC_ e embute
# no bundle em tempo de build , não precisa de nenhuma lib extra.
# Em dev, aponte pro IP da sua máquina na rede local (não localhost ,
# o celular é outro dispositivo na rede, "localhost" seria ele mesmo).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Certificate/public-key pinning (ver src/security/sslPinning.ts). Deixe
# vazio em desenvolvimento local (HTTP) -- pinning fica desativado
# automaticamente sem essas duas variáveis. Preencha só nos perfis
# preview/production do eas.json, depois que o domínio tiver HTTPS real
# na Hostinger (o comando pra gerar os pins está no topo do arquivo
# sslPinning.ts).
EXPO_PUBLIC_SSL_PIN_HOST=
EXPO_PUBLIC_SSL_PINS=
