# O expo install --fix (upgrade SDK 51 -> 57) atualiza vários pacotes de
# uma vez (react, react-native, expo-*), e nesse meio-tempo o grafo de
# dependências passa por um estado transitório com peer deps
# conflitantes (ex.: react-native@0.86.3 pedindo @types/react@^19.x
# enquanto @types/react ainda não tinha sido atualizado). O legacy-peer-deps
# faz o npm não travar nesses conflitos transitórios , é o que o
# próprio Expo recomenda pra upgrades de SDK que saltam várias versões.
legacy-peer-deps=true
